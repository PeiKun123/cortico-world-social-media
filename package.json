{
  "name": "cortico-world-social-media",
  "version": "0.6.13",
  "type": "module",
  "description": "小鲸鱼爱冲浪：在 B 站、抖音、小红书和贴吧读作品、看评论并特别关注主人。按平台设置闲逛和评论权限，可选语料学习与 Gemini 网页陪练。百度贴吧为实验接入。",
  "license": "MIT",
  "engines": {
    "node": ">=22.16"
  },
  "main": "./src/index.ts",
  "keywords": [
    "cortico-world",
    "cortico",
    "bilibili",
    "social-media",
    "video",
    "comments",
    "companion",
    "douyin",
    "xiaohongshu",
    "tieba"
  ],
  "cortico": {
    "kind": "world",
    "api": 6,
    "displayName": "小鲸鱼爱冲浪",
    "describe": "describe.json",
    "webUiClient": "dist/webui-surf-idle-clock.js",
    "webUiStyle": "dist/webui-surf-idle-clock.css",
    "tags": [
      "video",
      "browser",
      "internet",
      "external-setup",
      "high-cost",
      "unofficial-api"
    ],
    "icon": "assets/icon-surf.png",
    "locales": {
      "zh": {
        "displayName": "小鲸鱼爱冲浪",
        "description": "小鲸鱼爱冲浪：在 B 站、抖音、小红书和贴吧读作品、看评论并特别关注主人。按平台设置闲逛和评论权限，可选语料学习与 Gemini 网页陪练。百度贴吧为实验接入。"
      },
      "en": {
        "displayName": "Little Whale Loves Surfing",
        "description": "Browse works and comments on Bilibili, Douyin, Xiaohongshu and Tieba. Configure owner focus, browsing and comment permissions by platform. Includes optional expression learning and Gemini web coaching. Tieba is experimental."
      }
    }
  },
  "files": [
    "src",
    "dist/webui-surf-idle-clock.js",
    "dist/webui-surf-idle-clock.css",
    "describe.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "assets/icon-surf.png"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepack": "node scripts/prepack.mjs"
  },
  "dependencies": {
    "playwright-core": "1.62.1",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/node": "^22.10.0",
    "@types/qrcode": "^1.5.5",
    "@types/ws": "^8.18.2",
    "cortico": "^0.2.5",
    "esbuild": "^0.28.2",
    "express": "^4.22.3",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "ws": "^8.22.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "author": "peikun123",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PeiKun123/cortico-world-social-media.git"
  },
  "bugs": {
    "url": "https://github.com/PeiKun123/cortico-world-social-media/issues"
  },
  "homepage": "https://github.com/PeiKun123/cortico-world-social-media#readme"
}
